# PFL — variáveis de ambiente obrigatórias (Supabase)
# Copie este arquivo para `.env.local` e preencha com as credenciais reais.
# NÃO comite `.env.local` nem qualquer arquivo com credenciais reais.

# URL do projeto Supabase (cliente público e server-side).
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública anônima (anon). Usada pelo cliente público (browser/server).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role (somente server). NUNCA usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
